# Development Dockerfile for Mind2 Frontend
# Runs Vite dev server with hot-reload enabled
FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY main-system/app-frontend/package.json main-system/app-frontend/package-lock.json* ./

# Install dependencies (including dev dependencies)
RUN npm install

# Copy source code (will be overridden by volume mount in docker-compose)
COPY main-system/app-frontend .

# Copy the shared status definitions to root (needed by Process.jsx import path)
COPY shared /shared

# Expose Vite dev server port
EXPOSE 5169

# Start Vite dev server
# Note: --host is redundant since vite.config.js sets host: '0.0.0.0'
CMD ["npm", "run", "dev"]
